"classes.mage_description" = "Čarobnjaci brzo uče, stječući Iskustvo i Razine brže od ostalih klasa. Također dobivaju veliku količinu Mane za korištenje posebnih sposobnosti. Odaberite Čarobnjaka ako uživate u taktičkim aspektima Habitice ili ako vas snažno motivira povećavanje razine i otključavanje naprednih značajki!";
/* (No Comment) */
"classes.rogue" = "Lupež";
/* (No Comment) */
"classes.rogue_description" = "Lupeži obožavaju gomilati bogatstvo, zarađujući više Zlata od bilo koje druge klase i vješti su u pronalasku nasumičnih predmeta. Njihova prepoznatljiva vještina Prikrivanja omogućuje im da izbjegnu posljedice propuštenih Dnevnih zadataka. Odaberite Lupeža ako vas snažno motiviraju Nagrade i Postignuća, te ako težite plijenu i značkama!";
/* (No Comment) */
"classes.warrior" = "Ratnik";
