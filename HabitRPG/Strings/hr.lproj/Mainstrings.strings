/* (No Comment) */
"classes.healer_description" = "Iscjelitelji nepokolebljivo stoje protiv štete te tu zaštitu pružaju i drugima. Propušteni Dnevni zadaci i loše Navike ih ne uznemiravaju previše, a imaju i načine za obnavljanje Zdravlja usprkos neuspjehu. Odaberite Iscjelitelja ako uživate u pomaganju drugima u svojoj Grupi ili ako vas inspirira ideja izbjegavanja Smrti marljivim radom!";
/* (No Comment) */
"classes.mage" = "Čarobnjak";
